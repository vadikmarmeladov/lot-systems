node_modules/
dist/
.env
.env.*
!.env.example
*.log
.DS_Store
coverage/
.vscode/
.idea/

# Environment and secret files
.env.local
.env.backup
.backups/.env*
.config-backups/.env*
config/backups/.env*

# Security: SSH keys and credentials
*.key
*.key.pub
*.pgpass
*.pem
*.p12
id_rsa*
id_ed25519*
LOT_*_key_git*

# SQL dumps (use managed backups, not repo)
*.sql

# Configuration files with secrets (keep example versions)
app.yaml
spec.yaml
digital-ocean-app-spec.yaml
!.yaml.example
!app.yaml.example
!spec.yaml.example

# Backup and working files
package.json.backup
package.json.working
package.json.working-backup
postcss.config.*.backup
*.backup
*.working
*.working-backup

# Compiled output (should not be in repo) — dist/ above already covers this;
# a bare "server/" here was matching src/server/ too and silently dropping
# new server source files from git status.
*.js.map

# Archive files
*.tar.gz
*.zip
*-archive/
lot-systems_v*
*ARCHIVE_README*
lot-systems_master_*

# Production backups (stored separately, not in git)
backups/production-*
backups/encrypted/
backups/full-backup-*
backups/*.tar.gz
backups/*.sql
backups/*.sql.gz
backups/*.enc

# Suspicious files
yarn 2.lock

# Random/unnecessary files
*.mp3
touch
middleware.ts
server.ts

# Security: Certificate files
*.crt
*.cer
certs/

# Security: Token/credential files
*.token
*.credentials
.secrets/

# Audit logs (may contain sensitive data)
audit-logs/
*.audit.log

# OS files
.DS_Store
.*.DS_Store

# Python cache
__pycache__/
*.pyc
*.pyo
