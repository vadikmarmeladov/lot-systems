# ═══════════════════════════════════════════════════════════════════
# LOT SYSTEMS CORPORATION — NODE-0 ENVIRONMENT
# Self-Hosted / Local-Inference / Audit-by-Default
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=8080
APP_NAME="LOT"
APP_HOST="https://lot-systems.com"
APP_DESCRIPTION="LOT is a subscription service that distributes digital and physical necessities, basic wardrobes, organic self-care products, home and kids essentials."

# ─── DATABASE (local Postgres) ────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=lotdb
DB_USER=lot
DB_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
DB_SSL=false

# ─── AUTH ─────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ─── ADMIN ────────────────────────────────────────────────────────
ADMIN_EMAILS=vadikmarmeladov@gmail.com

# ─── LOCAL INFERENCE (Ollama) ─────────────────────────────────────
# Primary engine — runs on your metal
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434

# ─── CLOUD AI (fallback — optional when local is running) ─────────
# Together AI (cheapest cloud fallback)
# TOGETHER_API_KEY=your_together_api_key_here

# Anthropic Claude (optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (optional)
# OPENAI_API_KEY=your_openai_api_key_here

# ─── EMAIL ────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=support@lot-systems.com
RESEND_FROM_NAME="LOT"

# ─── BACKUP ───────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here
